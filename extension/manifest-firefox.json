{
    "manifest_version": 2,
    "name": "YouTube Cookie Sync",
    "description": "Continuously sync YouTube cookies to a self-hosted endpoint.",
    "version": "1.0.0",
    "icons": {
        "128": "/images/icon128.png"
    },
    "browser_action": {
        "default_icon": "/images/icon.png",
        "default_popup": "index.html"
    },
    "permissions": [
        "storage",
        "cookies",
        "https://*.youtube.com/*"
    ],
    "background": {
        "scripts": ["background.js"]
    }
}