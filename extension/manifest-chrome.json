{
    "manifest_version": 3,
    "name": "YouTube Cookie Sync",
    "description": "Continuously sync YouTube cookies to a self-hosted endpoint.",
    "version": "1.0.0",
    "icons": {
        "48": "/images/icon.png",
        "128": "/images/icon128.png"
    },
    "action": {
        "default_popup": "index.html"
    },
    "permissions": [
        "storage",
        "cookies"
    ],
    "host_permissions": [
        "https://*.youtube.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    }
}